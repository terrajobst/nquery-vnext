.vscode/**
.vscode-test/**
.vscode-test.mjs
src/**
tests/**

# `main` points at the bundle, so the tsc output ships nothing -- it exists to type check and to
# give the tests something to run.
out/**

dist/**/*.map

# Everything the extension imports is inlined into the bundle, so none of this is needed at
# runtime. This is most of what a non-bundled VSIX carries.
node_modules/**

esbuild.js
tsconfig.json
.gitignore
