<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet generates and JIT-compiles its own runner; Release is required. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The live engine (assembly "NQuery") is the new version from this worktree and is
      referenced normally, so its types are just NQuery.*. The baseline is the NQuery project
      from the sibling "nquery-baseline" worktree (checked out at the comparison point, e.g.
      main), which must be built separately beforehand (benchmarks run in Release, so build it
      Release):

        dotnet build ..\..\..\nquery-baseline\src\NQuery -c Release

      That project sets AssemblyName=NQuery.Baseline so it loads side-by-side with the live
      NQuery (same NQuery.* types otherwise); we consume it as a plain aliased Reference,
      addressed as baseline::NQuery.* via the extern
      alias lines in the benchmark sources. A ProjectReference is deliberately not used: the
      worktree project's file name is also "NQuery.csproj", so it would collide with the live
      NQuery in deps.json (both keyed by project name) and one engine would fail to load at run
      time.
    -->
    <ProjectReference Include="..\NQuery\NQuery.csproj" />
    <!-- The typed Northwind data (NQuery.Northwind.NorthwindData) lives here and is shared by
         both engines via the live NQuery assembly. -->
    <ProjectReference Include="..\NQuery.Testing\NQuery.Testing.csproj" />
    <Reference Include="NQuery.Baseline" Aliases="baseline" Private="true">
      <HintPath>..\..\..\nquery-baseline\artifacts\bin\NQuery\release_net8.0\NQuery.Baseline.dll</HintPath>
    </Reference>
    <!-- The original NQuery engine from the sibling "nquery-old" repo, whose NQuery.csproj was
         converted in-place to an SDK-style net8.0 library with AssemblyName=NQuery.Old. Build it
         separately beforehand (Release):

           dotnet build ..\..\..\nquery-old\Src\NQuery\NQuery.csproj -c Release

         Like the baseline, it is consumed as an aliased Reference (addressed as old::NQuery.*)
         rather than a ProjectReference, so the original engine loads side-by-side with the live
         and baseline NQuery.* types. Its output is plain bin\Release (not artifacts), as the old
         repo has no Directory.Build.props. -->
    <Reference Include="NQuery.Old" Aliases="old" Private="true">
      <HintPath>..\..\..\nquery-old\Src\NQuery\bin\Release\net8.0\NQuery.Old.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
